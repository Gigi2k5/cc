{
  "name": "comlan-community-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:shell": "bash tools/visual/run.sh checks/shell.mjs",
    "check:hero": "bash tools/visual/run.sh checks/hero.mjs",
    "check:content": "bash tools/visual/run.sh checks/content.mjs",
    "shots": "bash tools/visual/run.sh checks/shots.mjs",
    "check:community": "bash tools/visual/run.sh checks/community.mjs",
    "check:evenements": "bash tools/visual/run.sh checks/evenements.mjs",
    "check:faq": "bash tools/visual/run.sh checks/faq-contact.mjs",
    "check:motion": "bash tools/visual/run.sh checks/motion.mjs",
    "check:touch": "POINTER=coarse bash tools/visual/run.sh checks/touch.mjs",
    "check:audit": "bash tools/visual/run.sh checks/audit.mjs",
    "check:breakpoints": "bash tools/visual/run.sh checks/breakpoints.mjs",
    "check:responsive": "bash tools/visual/run.sh checks/responsive.mjs",
    "check:responsive:touch": "POINTER=coarse bash tools/visual/run.sh checks/responsive.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
